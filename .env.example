# Environment Configuration for RACKS

# Node environment (development, production, test)
NODE_ENV=development

# Ollama LLM Service
# URL of the Ollama service for LLM inference
# Default: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# Wayfarer Web Research Service
# URL of the Wayfarer service for web scraping and research
# Default: http://localhost:8889
WAYFARER_URL=http://localhost:8889

# SearXNG Search Service
# URL of the SearXNG service for web search
# Default: http://localhost:8888
SEARXNG_URL=http://localhost:8888

# Logging level (debug, info, warn, error)
# Default: info
LOG_LEVEL=info

# Optional: Database file path for task persistence
# Default: ./racks.db
DATABASE_PATH=./racks.db

# Optional: Max memory for research session (MB)
# Default: 2048 (2 GB)
MAX_MEMORY=2048

# Optional: Max duration for research session (minutes)
# Default: 300 (5 hours)
MAX_DURATION=300
